# Public origin used for canonical URLs, sitemap, RSS and social cards.
NEXT_PUBLIC_SITE_URL=https://mdsaifali.vercel.app

# Copy to .env.local and fill in. Never commit real values.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
# Max assistant answers per day across all visitors (protects the Gemini quota / bill).
CHAT_DAILY_BUDGET=300
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
EVAL_TOKEN=
# Contact form (Resend). Change CONTACT_FROM_EMAIL once you verify a domain in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Visitor telemetry: random secret used to salt IP hashes (any long random string).
TELEMETRY_SALT=
